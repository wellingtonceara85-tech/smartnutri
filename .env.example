# Variáveis usadas pelo docker-compose.yml na raiz do projeto.
# Para rodar backend/frontend fora do Docker, use os .env.example de cada pasta
# (backend/.env.example, frontend/.env.example) — as portas locais (fora do
# Docker) são diferentes das portas do docker-compose para não colidir com
# outros serviços já rodando na máquina (ex.: 5432/3000/3001 já ocupados).

# --- Postgres ---
POSTGRES_USER=clinica
POSTGRES_PASSWORD=clinica_dev_password
POSTGRES_DB=clinica_nutricao

# --- MinIO (armazenamento de documentos, S3-compatible) ---
MINIO_ROOT_USER=clinica_minio
MINIO_ROOT_PASSWORD=clinica_minio_password

# --- Backend ---
JWT_ACCESS_SECRET=troque-por-um-segredo-forte
JWT_REFRESH_SECRET=troque-por-outro-segredo-forte
