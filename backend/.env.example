# Use 127.0.0.1 (não "localhost") — em alguns ambientes Windows/WSL2 o
# Prisma CLI tenta resolver "localhost" via IPv6 e falha ao conectar no
# Postgres publicado pelo Docker.
DATABASE_URL="postgresql://clinica:clinica_dev_password@127.0.0.1:5440/clinica_nutricao?schema=public"

NODE_ENV=development
PORT=3001

JWT_ACCESS_SECRET=troque-por-um-segredo-forte
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=troque-por-outro-segredo-forte
JWT_REFRESH_EXPIRES_IN=30d

CORS_ORIGIN=http://localhost:3020
COOKIE_SECURE=false

# MinIO (S3-compatible) — STORAGE_ENDPOINT é usado pelo backend para operações
# reais; STORAGE_PUBLIC_ENDPOINT é o host que o navegador do usuário consegue
# alcançar e é o único usado para assinar URLs de download. Rodando fora do
# Docker, os dois apontam para o mesmo host (127.0.0.1:9020).
STORAGE_ENDPOINT=http://127.0.0.1:9020
STORAGE_PUBLIC_ENDPOINT=http://127.0.0.1:9020
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=clinica_minio
STORAGE_SECRET_ACCESS_KEY=clinica_minio_password
STORAGE_BUCKET=clinica-nutricao-uploads
