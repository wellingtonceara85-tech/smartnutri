# Para desenvolvimento local, copie este arquivo para .env.dev (não .env) —
# o nome .env é reservado pelo Firebase Functions (carregado automaticamente
# no deploy do backend) e não pode conter os mesmos nomes de variável
# declarados como secret (DATABASE_URL, JWT_*, STORAGE_ACCESS_KEY_ID,
# STORAGE_SECRET_ACCESS_KEY), senão o deploy falha com "overlaps non secret
# environment variable".
#
# APP_ENV identifica o ambiente lógico (local | staging). É diferente de
# NODE_ENV (que controla otimizações do Node/Nest) — usado para decisões de
# produto/infra, como habilitar a proteção do Swagger.
APP_ENV=local

# Use 127.0.0.1 (não "localhost") — em alguns ambientes Windows/WSL2 o
# Prisma CLI tenta resolver "localhost" via IPv6 e falha ao conectar no
# Postgres publicado pelo Docker.
DATABASE_URL="postgresql://clinica:clinica_dev_password@127.0.0.1:5440/clinica_nutricao?schema=public"

# Só necessário em provedores com connection pooling (ex.: Neon). É a conexão
# direta (sem pooler) usada exclusivamente pelo Prisma CLI para migrations
# (ver backend/prisma.config.ts). Localmente pode ficar vazia/ausente — cai
# de volta para DATABASE_URL.
DIRECT_DATABASE_URL=

NODE_ENV=development
PORT=3001

JWT_ACCESS_SECRET=troque-por-um-segredo-forte
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=troque-por-outro-segredo-forte
JWT_REFRESH_EXPIRES_IN=30d

CORS_ORIGIN=http://localhost:3020

# Cookie do refresh token. Em staging (frontend na Vercel, backend em Cloud
# Functions — domínios diferentes) é OBRIGATÓRIO usar:
#   COOKIE_SECURE=true
#   COOKIE_SAME_SITE=none
# Localmente (mesmo domínio, http) deixe como abaixo.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Se definidos, protegem /api/docs (Swagger) com HTTP Basic Auth. Deixe vazio
# localmente; preencha em staging.
SWAGGER_USER=
SWAGGER_PASSWORD=

# MinIO (S3-compatible) — STORAGE_ENDPOINT é usado pelo backend para operações
# reais; STORAGE_PUBLIC_ENDPOINT é o host que o navegador do usuário consegue
# alcançar e é o único usado para assinar URLs de download. Rodando fora do
# Docker, os dois apontam para o mesmo host (127.0.0.1:9020). Em staging,
# essas mesmas variáveis apontam para o bucket Cloudflare R2 (endpoint da
# conta R2 + credenciais do token de API) — nenhum código muda, só valores.
STORAGE_ENDPOINT=http://127.0.0.1:9020
STORAGE_PUBLIC_ENDPOINT=http://127.0.0.1:9020
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=clinica_minio
STORAGE_SECRET_ACCESS_KEY=clinica_minio_password
STORAGE_BUCKET=clinica-nutricao-uploads
