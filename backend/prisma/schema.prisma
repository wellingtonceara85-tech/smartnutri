// Prisma schema — Sistema de Gestão para Clínica de Nutrição
// Convenções: UUID PKs, createdAt/updatedAt/deletedAt (soft delete) em toda
// tabela de negócio, valores monetários sempre Decimal (nunca Float),
// tenantId presente em toda tabela de negócio para isolamento multi-clínica.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ==========================================================================
// Identidade / Tenant
// ==========================================================================

model Tenant {
  id                         String    @id @default(uuid())
  name                       String
  slug                       String    @unique
  cnpj                       String?
  email                      String
  phone                      String
  timezone                   String    @default("America/Sao_Paulo")
  addressLine                String?
  city                       String?
  state                      String?
  cancellationPolicyText     String?
  cancellationMinHoursNotice Int?
  receiptNumberPrefix        String?
  receiptNumberNextSeq       Int       @default(1)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  deletedAt                  DateTime?

  userClinics                    UserClinic[]
  patients                       Patient[]
  plans                          Plan[]
  appointmentTypes               AppointmentType[]
  paymentMethods                 PaymentMethod[]
  treatmentCycles                TreatmentCycle[]
  appointments                   Appointment[]
  charges                        Charge[]
  payments                       Payment[]
  patientEvolutions              PatientEvolution[]
  documents                      Document[]
  auditLogs                      AuditLog[]
  professionalProfile            ProfessionalProfile?
  anthropometricMeasurements     AnthropometricMeasurement[]
  bioimpedanceMeasurements       BioimpedanceMeasurement[]
  segmentalBodyMeasurements      SegmentalBodyMeasurement[]
  segmentalImpedanceMeasurements SegmentalImpedanceMeasurement[]
  measurementReferenceRanges     MeasurementReferenceRange[]
  evolutionPhotos                EvolutionPhoto[]
}

enum Role {
  ADMIN
  NUTRITIONIST
  RECEPTION
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  userClinics             UserClinic[]
  refreshTokens           RefreshToken[]
  createdCycles           TreatmentCycle[]           @relation("CycleCreatedBy")
  appointmentsAsNutri     Appointment[]              @relation("AppointmentNutritionist")
  statusChanges           AppointmentStatusHistory[]
  createdPayments         Payment[]                  @relation("PaymentCreatedBy")
  createdRefunds          Refund[]                   @relation("RefundCreatedBy")
  createdEvolutions       PatientEvolution[]         @relation("EvolutionCreatedBy")
  updatedEvolutions       PatientEvolution[]         @relation("EvolutionUpdatedBy")
  nutritionistEvolutions  PatientEvolution[]         @relation("EvolutionNutritionist")
  sharedEvolutions        PatientEvolution[]         @relation("EvolutionSharedBy")
  uploadedDocuments       Document[]                 @relation("DocumentUploadedBy")
  uploadedEvolutionPhotos EvolutionPhoto[]           @relation("EvolutionPhotoUploadedBy")
  auditLogEntries         AuditLog[]
  patientsAsResponsible   Patient[]                  @relation("PatientResponsibleNutritionist")
  professionalProfiles    ProfessionalProfile[]
}

/**
 * Identidade do profissional exibida na interface — SmartNutri é a
 * plataforma; nome, foto, CRN e cores aqui pertencem ao profissional, não
 * a uma clínica fictícia. 1:1 por tenant (um profissional principal por
 * ambiente nesta etapa); userId aponta para quem é "dono" da identidade.
 */
model ProfessionalProfile {
  id                String   @id @default(uuid())
  tenantId          String   @unique
  userId            String?
  displayName       String
  professionalName  String
  professionalTitle String?
  crnNumber         String?
  crnState          String?
  specialty         String?
  shortBio          String?
  profilePhotoKey   String?
  logoKey           String?
  primaryPhone      String?
  whatsappPhone     String?
  email             String?
  instagram         String?
  website           String?
  companyName       String?
  legalName         String?
  documentNumber    String?
  addressLine       String?
  paletteKey        String?  @default("sage")
  primaryColor      String   @default("#3F7658")
  secondaryColor    String   @default("#8CAF9A")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])
}

model UserClinic {
  id        String   @id @default(uuid())
  userId    String
  tenantId  String
  role      Role
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nutritionistProfile NutritionistProfile?

  @@unique([userId, tenantId])
  @@index([tenantId])
}

model NutritionistProfile {
  id            String   @id @default(uuid())
  tenantId      String
  userClinicId  String   @unique
  licenseNumber String?
  specialty     String?
  bio           String?
  calendarColor String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userClinic UserClinic @relation(fields: [userClinicId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  tokenHash         String
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  createdByIp       String?
  userAgent         String?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ==========================================================================
// Pacientes / Catálogo
// ==========================================================================

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum PatientStatus {
  ACTIVE
  INACTIVE
  PAUSED
  DISCHARGED
  ARCHIVED
}

/**
 * Preferência de silhueta para o mapa corporal (BodySegmentMap) — nunca
 * inferida automaticamente a partir de identidade de gênero; o profissional
 * escolhe manualmente, com sugestão inicial a partir de `gender`.
 */
enum SilhouettePreference {
  MALE
  FEMALE
  NEUTRAL
  NOT_INFORMED
}

model Patient {
  id                        String               @id @default(uuid())
  tenantId                  String
  fullName                  String
  socialName                String?
  cpf                       String?
  birthDate                 DateTime?
  gender                    Gender?
  bodySilhouettePreference  SilhouettePreference @default(NOT_INFORMED)
  occupation                String?
  email                     String?
  primaryPhone              String?
  secondaryPhone            String?
  whatsappPhone             String?
  zipCode                   String?
  street                    String?
  number                    String?
  complement                String?
  neighborhood              String?
  city                      String?
  state                     String?
  emergencyContactName      String?
  emergencyContactPhone     String?
  administrativeNotes       String?
  source                    String?
  responsibleNutritionistId String?
  status                    PatientStatus        @default(ACTIVE)
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  deletedAt                 DateTime?

  tenant                  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  responsibleNutritionist User?              @relation("PatientResponsibleNutritionist", fields: [responsibleNutritionistId], references: [id])
  treatmentCycles         TreatmentCycle[]
  appointments            Appointment[]
  charges                 Charge[]
  payments                Payment[]
  patientEvolutions       PatientEvolution[]
  documents               Document[]

  @@unique([tenantId, cpf])
  @@index([tenantId, status])
  @@index([tenantId, responsibleNutritionistId])
  @@index([tenantId, fullName])
}

model Plan {
  id                    String    @id @default(uuid())
  tenantId              String
  name                  String
  description           String?
  durationMonths        Int
  suggestedAppointments Int
  suggestedIntervalDays Int
  defaultPrice          Decimal   @db.Decimal(12, 2)
  defaultInstallments   Int
  allowsDiscount        Boolean   @default(true)
  isActive              Boolean   @default(true)
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  treatmentCycles TreatmentCycle[]

  // Unicidade de nome por tenant apenas entre planos não excluídos —
  // constraint parcial adicionada via SQL manual na migration (Prisma não
  // suporta índice único condicional na declaração do schema).
  @@index([tenantId, name])
}

model AppointmentType {
  id                     String   @id @default(uuid())
  tenantId               String
  name                   String
  defaultDurationMinutes Int      @default(60)
  color                  String?
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([tenantId, name])
}

model PaymentMethod {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@unique([tenantId, name])
}

// ==========================================================================
// Ciclos de acompanhamento / Consultas
// ==========================================================================

enum CycleStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  RENEWED
}

model TreatmentCycle {
  id              String      @id @default(uuid())
  tenantId        String
  patientId       String
  planId          String
  cycleNumber     Int
  status          CycleStatus @default(DRAFT)
  startDate       DateTime
  expectedEndDate DateTime?
  actualEndDate   DateTime?

  // Snapshot dos valores do Plan no momento da criação (nunca referência viva)
  appointmentCountPlanned Int
  intervalDaysPlanned     Int
  contractedValue         Decimal @db.Decimal(12, 2)
  discount                Decimal @default(0) @db.Decimal(12, 2)
  surcharge               Decimal @default(0) @db.Decimal(12, 2)
  finalValue              Decimal @db.Decimal(12, 2)
  downPayment             Decimal @default(0) @db.Decimal(12, 2)
  installmentCount        Int

  notes              String?
  closureReason      String?
  renewedFromCycleId String?   @unique
  createdByUserId    String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient          Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  plan             Plan            @relation(fields: [planId], references: [id])
  createdByUser    User            @relation("CycleCreatedBy", fields: [createdByUserId], references: [id])
  renewedFromCycle TreatmentCycle? @relation("CycleRenewal", fields: [renewedFromCycleId], references: [id])
  renewedIntoCycle TreatmentCycle? @relation("CycleRenewal")
  appointments     Appointment[]
  charges          Charge[]

  @@unique([tenantId, patientId, cycleNumber])
  @@index([tenantId, status])
}

enum AppointmentStatus {
  SCHEDULED
  AWAITING_CONFIRMATION
  CONFIRMED
  IN_PROGRESS
  DONE
  CANCELLED_BY_CLINIC
  CANCELLED_BY_PATIENT
  NO_SHOW
  RESCHEDULED
}

enum AppointmentModality {
  IN_PERSON
  ONLINE
  HOME_VISIT
}

model Appointment {
  id                           String              @id @default(uuid())
  tenantId                     String
  treatmentCycleId             String
  patientId                    String
  nutritionistUserId           String
  appointmentTypeId            String
  scheduledAt                  DateTime
  durationMinutes              Int
  sequenceNumber               Int
  status                       AppointmentStatus   @default(SCHEDULED)
  modality                     AppointmentModality @default(IN_PERSON)
  location                     String?
  adminNotes                   String?
  clinicalNotes                String?
  cancellationReason           String?
  rescheduledFromAppointmentId String?             @unique
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt
  deletedAt                    DateTime?

  tenant                     Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  treatmentCycle             TreatmentCycle             @relation(fields: [treatmentCycleId], references: [id], onDelete: Cascade)
  patient                    Patient                    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  nutritionistUser           User                       @relation("AppointmentNutritionist", fields: [nutritionistUserId], references: [id])
  appointmentType            AppointmentType            @relation(fields: [appointmentTypeId], references: [id])
  rescheduledFromAppointment Appointment?               @relation("AppointmentReschedule", fields: [rescheduledFromAppointmentId], references: [id])
  rescheduledIntoAppointment Appointment?               @relation("AppointmentReschedule")
  statusHistory              AppointmentStatusHistory[]
  charges                    Charge[]
  patientEvolutions          PatientEvolution[]

  @@index([tenantId, nutritionistUserId, scheduledAt])
  @@index([tenantId, patientId])
}

model AppointmentStatusHistory {
  id              String             @id @default(uuid())
  tenantId        String
  appointmentId   String
  fromStatus      AppointmentStatus?
  toStatus        AppointmentStatus
  changedByUserId String
  reason          String?
  changedAt       DateTime           @default(now())

  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  changedByUser User        @relation(fields: [changedByUserId], references: [id])

  @@index([appointmentId])
}

// ==========================================================================
// Financeiro
// ==========================================================================

enum ChargeStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
}

model Charge {
  id                String       @id @default(uuid())
  tenantId          String
  treatmentCycleId  String
  patientId         String
  appointmentId     String?
  installmentNumber Int
  installmentTotal  Int
  description       String?
  amount            Decimal      @db.Decimal(12, 2)
  discount          Decimal      @default(0) @db.Decimal(12, 2)
  surcharge         Decimal      @default(0) @db.Decimal(12, 2)
  dueDate           DateTime     @db.Date
  status            ChargeStatus @default(PENDING)
  cancelledReason   String?
  notes             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  treatmentCycle TreatmentCycle      @relation(fields: [treatmentCycleId], references: [id], onDelete: Cascade)
  patient        Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment    Appointment?        @relation(fields: [appointmentId], references: [id])
  allocations    PaymentAllocation[]

  @@index([tenantId, patientId, status])
  @@index([tenantId, dueDate])
}

enum PaymentStatus {
  COMPLETED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id              String        @id @default(uuid())
  tenantId        String
  patientId       String
  paymentMethodId String
  amount          Decimal       @db.Decimal(12, 2)
  paidAt          DateTime
  referenceNote   String?
  receiptNumber   Int?
  status          PaymentStatus @default(COMPLETED)
  createdByUserId String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient       Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod       @relation(fields: [paymentMethodId], references: [id])
  createdByUser User                @relation("PaymentCreatedBy", fields: [createdByUserId], references: [id])
  allocations   PaymentAllocation[]
  refunds       Refund[]

  @@index([tenantId, patientId, paidAt])
}

model PaymentAllocation {
  id              String   @id @default(uuid())
  tenantId        String
  paymentId       String
  chargeId        String
  allocatedAmount Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  charge  Charge  @relation(fields: [chargeId], references: [id], onDelete: Cascade)

  @@unique([paymentId, chargeId])
  @@index([chargeId])
  @@index([paymentId])
}

model Refund {
  id              String   @id @default(uuid())
  tenantId        String
  paymentId       String
  amount          Decimal  @db.Decimal(12, 2)
  reason          String
  refundedAt      DateTime @default(now())
  createdByUserId String
  createdAt       DateTime @default(now())

  payment       Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  createdByUser User    @relation("RefundCreatedBy", fields: [createdByUserId], references: [id])

  @@index([paymentId])
}

// ==========================================================================
// Clínico / Auditoria
// ==========================================================================

enum EvolutionStatus {
  ACTIVE
  ARCHIVED
}

/**
 * Snapshot independente do paciente em uma data — nunca sobrescrito por
 * avaliações futuras. Os dados de medição ficam em tabelas filhas
 * (antropometria, bioimpedância, segmentar, fotos) para não virar uma
 * única tabela gigante. `clinicalNotes`/`internalNotes` nunca são visíveis
 * ao paciente; `patientVisibleNotes` é o único campo preparado para o
 * futuro Portal do Paciente.
 */
model PatientEvolution {
  id                  String          @id @default(uuid())
  tenantId            String
  patientId           String
  nutritionistUserId  String
  appointmentId       String?
  assessmentDate      DateTime        @db.Date
  assessmentTime      String?
  title               String?
  objective           String?
  clinicalNotes       String?
  internalNotes       String?
  patientVisibleNotes String?
  isSharedWithPatient Boolean         @default(false)
  sharedAt            DateTime?
  sharedByUserId      String?
  status              EvolutionStatus @default(ACTIVE)
  createdByUserId     String
  updatedByUserId     String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  deletedAt           DateTime?

  tenant                Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient               Patient                     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment           Appointment?                @relation(fields: [appointmentId], references: [id])
  nutritionistUser      User                        @relation("EvolutionNutritionist", fields: [nutritionistUserId], references: [id])
  createdByUser         User                        @relation("EvolutionCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUser         User?                       @relation("EvolutionUpdatedBy", fields: [updatedByUserId], references: [id])
  sharedByUser          User?                       @relation("EvolutionSharedBy", fields: [sharedByUserId], references: [id])
  anthropometry         AnthropometricMeasurement?
  bioimpedance          BioimpedanceMeasurement?
  segmentalMeasurements SegmentalBodyMeasurement[]
  referenceRanges       MeasurementReferenceRange[]
  photos                EvolutionPhoto[]

  @@index([tenantId, patientId, assessmentDate])
  @@index([tenantId, status])
}

/// Todas as medidas são opcionais — o profissional preenche só o que tiver.
model AnthropometricMeasurement {
  id                String   @id @default(uuid())
  tenantId          String
  evolutionId       String   @unique
  weightKg          Decimal? @db.Decimal(6, 2)
  heightCm          Decimal? @db.Decimal(5, 2)
  bmi               Decimal? @db.Decimal(5, 2)
  bmiClassification String?
  desiredWeightKg   Decimal? @db.Decimal(6, 2)

  neckCm         Decimal? @db.Decimal(5, 2)
  shoulderCm     Decimal? @db.Decimal(5, 2)
  chestCm        Decimal? @db.Decimal(5, 2)
  waistCm        Decimal? @db.Decimal(5, 2)
  abdomenCm      Decimal? @db.Decimal(5, 2)
  hipCm          Decimal? @db.Decimal(5, 2)
  gluteCm        Decimal? @db.Decimal(5, 2)
  rightArmCm     Decimal? @db.Decimal(5, 2)
  leftArmCm      Decimal? @db.Decimal(5, 2)
  rightForearmCm Decimal? @db.Decimal(5, 2)
  leftForearmCm  Decimal? @db.Decimal(5, 2)
  rightThighCm   Decimal? @db.Decimal(5, 2)
  leftThighCm    Decimal? @db.Decimal(5, 2)
  rightCalfCm    Decimal? @db.Decimal(5, 2)
  leftCalfCm     Decimal? @db.Decimal(5, 2)

  tricepsSkinfoldMm     Decimal? @db.Decimal(5, 2)
  bicepsSkinfoldMm      Decimal? @db.Decimal(5, 2)
  subscapularSkinfoldMm Decimal? @db.Decimal(5, 2)
  suprailiacSkinfoldMm  Decimal? @db.Decimal(5, 2)
  abdominalSkinfoldMm   Decimal? @db.Decimal(5, 2)
  chestSkinfoldMm       Decimal? @db.Decimal(5, 2)
  midaxillarySkinfoldMm Decimal? @db.Decimal(5, 2)
  thighSkinfoldMm       Decimal? @db.Decimal(5, 2)
  calfSkinfoldMm        Decimal? @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  evolution PatientEvolution @relation(fields: [evolutionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Dados de bioimpedância — variam por equipamento, todos opcionais.
model BioimpedanceMeasurement {
  id                     String   @id @default(uuid())
  tenantId               String
  evolutionId            String   @unique
  bodyFatPercent         Decimal? @db.Decimal(4, 1)
  fatMassKg              Decimal? @db.Decimal(6, 2)
  leanMassKg             Decimal? @db.Decimal(6, 2)
  muscleMassKg           Decimal? @db.Decimal(6, 2)
  skeletalMuscleMassKg   Decimal? @db.Decimal(6, 2)
  musclePercent          Decimal? @db.Decimal(4, 1)
  bodyWaterLiters        Decimal? @db.Decimal(5, 2)
  bodyWaterPercent       Decimal? @db.Decimal(4, 1)
  proteinKg              Decimal? @db.Decimal(5, 2)
  proteinPercent         Decimal? @db.Decimal(4, 1)
  mineralMassKg          Decimal? @db.Decimal(5, 2)
  boneMassKg             Decimal? @db.Decimal(5, 2)
  visceralFatLevel       Decimal? @db.Decimal(4, 1)
  basalMetabolicRateKcal Int?
  metabolicAge           Int?
  waistHipRatio          Decimal? @db.Decimal(4, 2)
  obesityDegreePercent   Decimal? @db.Decimal(5, 1)
  bodyType               String?
  impedanceOhms          Decimal? @db.Decimal(7, 2)
  deviceManufacturer     String?
  notes                  String?

  /// Pontuação geral fornecida pelo equipamento — nunca calculada pelo SmartNutri, nome sempre genérico.
  bodyCompositionScore        Int?
  bodyCompositionScoreMaximum Int?
  bodyCompositionScoreLabel   String?
  bodyCompositionScoreSource  String?

  /// Metas/ajustes fornecidos pelo equipamento ou definidos pela nutricionista — valores podem ser negativos, positivos ou zero, sem interpretação automática.
  referenceWeightKg         Decimal? @db.Decimal(6, 2)
  recommendedWeightChangeKg Decimal? @db.Decimal(6, 2)
  recommendedFatChangeKg    Decimal? @db.Decimal(6, 2)
  recommendedMuscleChangeKg Decimal? @db.Decimal(6, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant                         Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  evolution                      PatientEvolution                @relation(fields: [evolutionId], references: [id], onDelete: Cascade)
  segmentalImpedanceMeasurements SegmentalImpedanceMeasurement[]

  @@index([tenantId])
}

/**
 * Impedância por frequência e segmento — estrutura flexível (não colunas
 * fixas para 20kHz/100kHz) para aceitar equipamentos com uma, duas ou
 * múltiplas frequências.
 */
model SegmentalImpedanceMeasurement {
  id                        String   @id @default(uuid())
  tenantId                  String
  bioimpedanceMeasurementId String
  frequencyValue            Decimal  @db.Decimal(7, 2)
  frequencyUnit             String   @default("kHz")
  rightArmOhms              Decimal? @db.Decimal(7, 2)
  leftArmOhms               Decimal? @db.Decimal(7, 2)
  trunkOhms                 Decimal? @db.Decimal(7, 2)
  rightLegOhms              Decimal? @db.Decimal(7, 2)
  leftLegOhms               Decimal? @db.Decimal(7, 2)
  impedanceUnit             String   @default("ohm")
  deviceManufacturer        String?
  notes                     String?
  createdAt                 DateTime @default(now())

  tenant                  Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bioimpedanceMeasurement BioimpedanceMeasurement @relation(fields: [bioimpedanceMeasurementId], references: [id], onDelete: Cascade)

  @@unique([bioimpedanceMeasurementId, frequencyValue])
  @@index([tenantId])
}

/**
 * Faixa de referência opcional para qualquer campo da avaliação — genérica
 * por `fieldKey` (não uma coluna min/max por campo) porque cada equipamento
 * ou nutricionista pode fornecer referências diferentes. O SmartNutri nunca
 * diagnostica a partir daqui, só exibe o valor informado.
 */
model MeasurementReferenceRange {
  id          String   @id @default(uuid())
  tenantId    String
  evolutionId String
  fieldKey    String
  minValue    Decimal? @db.Decimal(8, 2)
  maxValue    Decimal? @db.Decimal(8, 2)
  unit        String?
  source      String?
  note        String?
  createdAt   DateTime @default(now())

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  evolution PatientEvolution @relation(fields: [evolutionId], references: [id], onDelete: Cascade)

  @@unique([evolutionId, fieldKey])
  @@index([tenantId])
}

enum BodySegment {
  RIGHT_ARM
  LEFT_ARM
  TRUNK
  RIGHT_LEG
  LEFT_LEG
}

enum SegmentalMetricType {
  FAT_MASS_KG
  LEAN_MASS_KG
}

/**
 * Modelado como linha por segmento+métrica (não colunas fixas) para
 * aceitar novas métricas segmentares no futuro sem alterar a estrutura.
 */
model SegmentalBodyMeasurement {
  id             String              @id @default(uuid())
  tenantId       String
  evolutionId    String
  segment        BodySegment
  metricType     SegmentalMetricType
  valueKg        Decimal             @db.Decimal(5, 2)
  /// Marca quando o próprio equipamento indica que o valor é estimado (comum em gordura segmentar).
  isEstimated    Boolean             @default(false)
  referenceMinKg Decimal?            @db.Decimal(5, 2)
  referenceMaxKg Decimal?            @db.Decimal(5, 2)
  createdAt      DateTime            @default(now())

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  evolution PatientEvolution @relation(fields: [evolutionId], references: [id], onDelete: Cascade)

  @@unique([evolutionId, segment, metricType])
  @@index([tenantId])
}

enum EvolutionPhotoType {
  FRONT
  BACK
  RIGHT_PROFILE
  LEFT_PROFILE
  OTHER
}

/// Fotos são dados sensíveis — nunca públicas; storageKey resolvido via URL pré-assinada de curta duração.
model EvolutionPhoto {
  id               String             @id @default(uuid())
  tenantId         String
  evolutionId      String
  type             EvolutionPhotoType
  storageKey       String
  mimeType         String
  sizeBytes        Int
  consentGranted   Boolean            @default(false)
  consentDate      DateTime?
  consentNotes     String?
  uploadedByUserId String
  createdAt        DateTime           @default(now())
  deletedAt        DateTime?

  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  evolution      PatientEvolution @relation(fields: [evolutionId], references: [id], onDelete: Cascade)
  uploadedByUser User             @relation("EvolutionPhotoUploadedBy", fields: [uploadedByUserId], references: [id])

  @@index([tenantId, evolutionId])
}

model Document {
  id               String    @id @default(uuid())
  tenantId         String
  patientId        String
  treatmentCycleId String?
  fileName         String
  storageKey       String
  mimeType         String
  sizeBytes        Int
  category         String?
  uploadedByUserId String
  createdAt        DateTime  @default(now())
  deletedAt        DateTime?

  tenant         Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient        Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  uploadedByUser User    @relation("DocumentUploadedBy", fields: [uploadedByUserId], references: [id])

  @@index([tenantId, patientId])
}

enum AuditAction {
  CREATE
  UPDATE
  CANCEL
  RESCHEDULE
  PAYMENT
  REFUND
  STATUS_CHANGE
  SOFT_DELETE
}

model AuditLog {
  id          String      @id @default(uuid())
  tenantId    String
  actorUserId String?
  entityType  String
  entityId    String
  action      AuditAction
  beforeJson  Json?
  afterJson   Json?
  metadata    Json?
  createdAt   DateTime    @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorUser User?  @relation(fields: [actorUserId], references: [id])

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
}
