// Prisma schema — Sistema de Gestão para Clínica de Nutrição
// Convenções: UUID PKs, createdAt/updatedAt/deletedAt (soft delete) em toda
// tabela de negócio, valores monetários sempre Decimal (nunca Float),
// tenantId presente em toda tabela de negócio para isolamento multi-clínica.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ==========================================================================
// Identidade / Tenant
// ==========================================================================

model Tenant {
  id                         String    @id @default(uuid())
  name                       String
  slug                       String    @unique
  cnpj                       String?
  email                      String
  phone                      String
  timezone                   String    @default("America/Sao_Paulo")
  addressLine                String?
  city                       String?
  state                      String?
  cancellationPolicyText     String?
  cancellationMinHoursNotice Int?
  receiptNumberPrefix        String?
  receiptNumberNextSeq       Int       @default(1)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  deletedAt                  DateTime?

  userClinics       UserClinic[]
  patients          Patient[]
  plans             Plan[]
  appointmentTypes  AppointmentType[]
  paymentMethods    PaymentMethod[]
  treatmentCycles   TreatmentCycle[]
  appointments      Appointment[]
  charges           Charge[]
  payments          Payment[]
  patientEvolutions PatientEvolution[]
  documents         Document[]
  auditLogs         AuditLog[]
}

enum Role {
  ADMIN
  NUTRITIONIST
  RECEPTION
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  userClinics         UserClinic[]
  refreshTokens       RefreshToken[]
  createdCycles       TreatmentCycle[]           @relation("CycleCreatedBy")
  appointmentsAsNutri Appointment[]              @relation("AppointmentNutritionist")
  statusChanges       AppointmentStatusHistory[]
  createdPayments     Payment[]                  @relation("PaymentCreatedBy")
  createdRefunds      Refund[]                   @relation("RefundCreatedBy")
  createdEvolutions   PatientEvolution[]         @relation("EvolutionCreatedBy")
  uploadedDocuments   Document[]                 @relation("DocumentUploadedBy")
  auditLogEntries     AuditLog[]
}

model UserClinic {
  id        String   @id @default(uuid())
  userId    String
  tenantId  String
  role      Role
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nutritionistProfile NutritionistProfile?

  @@unique([userId, tenantId])
  @@index([tenantId])
}

model NutritionistProfile {
  id            String   @id @default(uuid())
  tenantId      String
  userClinicId  String   @unique
  licenseNumber String?
  specialty     String?
  bio           String?
  calendarColor String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userClinic UserClinic @relation(fields: [userClinicId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  tokenHash         String
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  createdByIp       String?
  userAgent         String?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ==========================================================================
// Pacientes / Catálogo
// ==========================================================================

enum PatientSex {
  M
  F
  OTHER
}

enum PatientStatus {
  ACTIVE
  INACTIVE
  PAUSED
  DISCHARGED
  ARCHIVED
}

model Patient {
  id                    String        @id @default(uuid())
  tenantId              String
  fullName              String
  socialName            String?
  cpf                   String?
  birthDate             DateTime?
  sex                   PatientSex?
  profession            String?
  email                 String?
  phone                 String?
  whatsapp              String?
  addressLine           String?
  emergencyContactName  String?
  emergencyContactPhone String?
  adminNotes            String?
  origin                String?
  status                PatientStatus @default(ACTIVE)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  deletedAt             DateTime?

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  treatmentCycles   TreatmentCycle[]
  appointments      Appointment[]
  charges           Charge[]
  payments          Payment[]
  patientEvolutions PatientEvolution[]
  documents         Document[]

  @@unique([tenantId, cpf])
  @@index([tenantId, status])
}

model Plan {
  id                        String    @id @default(uuid())
  tenantId                  String
  name                      String
  description               String?
  durationMonths            Int
  suggestedAppointmentCount Int
  suggestedIntervalDays     Int
  defaultPrice              Decimal   @db.Decimal(12, 2)
  defaultInstallmentCount   Int
  allowsDiscount            Boolean   @default(true)
  isActive                  Boolean   @default(true)
  notes                     String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  deletedAt                 DateTime?

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  treatmentCycles TreatmentCycle[]

  @@unique([tenantId, name])
}

model AppointmentType {
  id                     String   @id @default(uuid())
  tenantId               String
  name                   String
  defaultDurationMinutes Int      @default(60)
  color                  String?
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([tenantId, name])
}

model PaymentMethod {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@unique([tenantId, name])
}

// ==========================================================================
// Ciclos de acompanhamento / Consultas
// ==========================================================================

enum CycleStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  RENEWED
}

model TreatmentCycle {
  id              String      @id @default(uuid())
  tenantId        String
  patientId       String
  planId          String
  cycleNumber     Int
  status          CycleStatus @default(DRAFT)
  startDate       DateTime
  expectedEndDate DateTime?
  actualEndDate   DateTime?

  // Snapshot dos valores do Plan no momento da criação (nunca referência viva)
  appointmentCountPlanned Int
  intervalDaysPlanned     Int
  contractedValue         Decimal @db.Decimal(12, 2)
  discount                Decimal @default(0) @db.Decimal(12, 2)
  surcharge               Decimal @default(0) @db.Decimal(12, 2)
  finalValue              Decimal @db.Decimal(12, 2)
  downPayment             Decimal @default(0) @db.Decimal(12, 2)
  installmentCount        Int

  notes              String?
  closureReason      String?
  renewedFromCycleId String?   @unique
  createdByUserId    String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient          Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  plan             Plan            @relation(fields: [planId], references: [id])
  createdByUser    User            @relation("CycleCreatedBy", fields: [createdByUserId], references: [id])
  renewedFromCycle TreatmentCycle? @relation("CycleRenewal", fields: [renewedFromCycleId], references: [id])
  renewedIntoCycle TreatmentCycle? @relation("CycleRenewal")
  appointments     Appointment[]
  charges          Charge[]

  @@unique([tenantId, patientId, cycleNumber])
  @@index([tenantId, status])
}

enum AppointmentStatus {
  SCHEDULED
  AWAITING_CONFIRMATION
  CONFIRMED
  IN_PROGRESS
  DONE
  CANCELLED_BY_CLINIC
  CANCELLED_BY_PATIENT
  NO_SHOW
  RESCHEDULED
}

enum AppointmentModality {
  IN_PERSON
  ONLINE
  HOME_VISIT
}

model Appointment {
  id                           String              @id @default(uuid())
  tenantId                     String
  treatmentCycleId             String
  patientId                    String
  nutritionistUserId           String
  appointmentTypeId            String
  scheduledAt                  DateTime
  durationMinutes              Int
  sequenceNumber               Int
  status                       AppointmentStatus   @default(SCHEDULED)
  modality                     AppointmentModality @default(IN_PERSON)
  location                     String?
  adminNotes                   String?
  clinicalNotes                String?
  cancellationReason           String?
  rescheduledFromAppointmentId String?             @unique
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt
  deletedAt                    DateTime?

  tenant                     Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  treatmentCycle             TreatmentCycle             @relation(fields: [treatmentCycleId], references: [id], onDelete: Cascade)
  patient                    Patient                    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  nutritionistUser           User                       @relation("AppointmentNutritionist", fields: [nutritionistUserId], references: [id])
  appointmentType            AppointmentType            @relation(fields: [appointmentTypeId], references: [id])
  rescheduledFromAppointment Appointment?               @relation("AppointmentReschedule", fields: [rescheduledFromAppointmentId], references: [id])
  rescheduledIntoAppointment Appointment?               @relation("AppointmentReschedule")
  statusHistory              AppointmentStatusHistory[]
  charges                    Charge[]
  patientEvolutions          PatientEvolution[]

  @@index([tenantId, nutritionistUserId, scheduledAt])
  @@index([tenantId, patientId])
}

model AppointmentStatusHistory {
  id              String             @id @default(uuid())
  tenantId        String
  appointmentId   String
  fromStatus      AppointmentStatus?
  toStatus        AppointmentStatus
  changedByUserId String
  reason          String?
  changedAt       DateTime           @default(now())

  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  changedByUser User        @relation(fields: [changedByUserId], references: [id])

  @@index([appointmentId])
}

// ==========================================================================
// Financeiro
// ==========================================================================

enum ChargeStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
}

model Charge {
  id                String       @id @default(uuid())
  tenantId          String
  treatmentCycleId  String
  patientId         String
  appointmentId     String?
  installmentNumber Int
  installmentTotal  Int
  description       String?
  amount            Decimal      @db.Decimal(12, 2)
  discount          Decimal      @default(0) @db.Decimal(12, 2)
  surcharge         Decimal      @default(0) @db.Decimal(12, 2)
  dueDate           DateTime     @db.Date
  status            ChargeStatus @default(PENDING)
  cancelledReason   String?
  notes             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  treatmentCycle TreatmentCycle      @relation(fields: [treatmentCycleId], references: [id], onDelete: Cascade)
  patient        Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment    Appointment?        @relation(fields: [appointmentId], references: [id])
  allocations    PaymentAllocation[]

  @@index([tenantId, patientId, status])
  @@index([tenantId, dueDate])
}

enum PaymentStatus {
  COMPLETED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id              String        @id @default(uuid())
  tenantId        String
  patientId       String
  paymentMethodId String
  amount          Decimal       @db.Decimal(12, 2)
  paidAt          DateTime
  referenceNote   String?
  receiptNumber   Int?
  status          PaymentStatus @default(COMPLETED)
  createdByUserId String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient       Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod       @relation(fields: [paymentMethodId], references: [id])
  createdByUser User                @relation("PaymentCreatedBy", fields: [createdByUserId], references: [id])
  allocations   PaymentAllocation[]
  refunds       Refund[]

  @@index([tenantId, patientId, paidAt])
}

model PaymentAllocation {
  id              String   @id @default(uuid())
  tenantId        String
  paymentId       String
  chargeId        String
  allocatedAmount Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  charge  Charge  @relation(fields: [chargeId], references: [id], onDelete: Cascade)

  @@unique([paymentId, chargeId])
  @@index([chargeId])
  @@index([paymentId])
}

model Refund {
  id              String   @id @default(uuid())
  tenantId        String
  paymentId       String
  amount          Decimal  @db.Decimal(12, 2)
  reason          String
  refundedAt      DateTime @default(now())
  createdByUserId String
  createdAt       DateTime @default(now())

  payment       Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  createdByUser User    @relation("RefundCreatedBy", fields: [createdByUserId], references: [id])

  @@index([paymentId])
}

// ==========================================================================
// Clínico / Auditoria
// ==========================================================================

model PatientEvolution {
  id                   String    @id @default(uuid())
  tenantId             String
  patientId            String
  appointmentId        String?
  measuredAt           DateTime
  weightKg             Decimal?  @db.Decimal(6, 2)
  heightCm             Decimal?  @db.Decimal(5, 2)
  bmi                  Decimal?  @db.Decimal(5, 2)
  waistCircumferenceCm Decimal?  @db.Decimal(5, 2)
  hipCircumferenceCm   Decimal?  @db.Decimal(5, 2)
  armCircumferenceCm   Decimal?  @db.Decimal(5, 2)
  bodyFatPercent       Decimal?  @db.Decimal(4, 1)
  muscleMassKg         Decimal?  @db.Decimal(6, 2)
  goal                 String?
  notes                String?
  createdByUserId      String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient       Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  createdByUser User         @relation("EvolutionCreatedBy", fields: [createdByUserId], references: [id])

  @@index([tenantId, patientId, measuredAt])
}

model Document {
  id               String    @id @default(uuid())
  tenantId         String
  patientId        String
  treatmentCycleId String?
  fileName         String
  storageKey       String
  mimeType         String
  sizeBytes        Int
  category         String?
  uploadedByUserId String
  createdAt        DateTime  @default(now())
  deletedAt        DateTime?

  tenant         Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient        Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  uploadedByUser User    @relation("DocumentUploadedBy", fields: [uploadedByUserId], references: [id])

  @@index([tenantId, patientId])
}

enum AuditAction {
  CREATE
  UPDATE
  CANCEL
  RESCHEDULE
  PAYMENT
  REFUND
  STATUS_CHANGE
  SOFT_DELETE
}

model AuditLog {
  id          String      @id @default(uuid())
  tenantId    String
  actorUserId String?
  entityType  String
  entityId    String
  action      AuditAction
  beforeJson  Json?
  afterJson   Json?
  metadata    Json?
  createdAt   DateTime    @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorUser User?  @relation(fields: [actorUserId], references: [id])

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
}
